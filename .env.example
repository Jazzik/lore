# /api/lead rate-limits by client IP, read from x-forwarded-for (preferred) or
# x-real-ip. Deploy behind a proxy/load balancer that sets one of these —
# without it, rate limiting is skipped entirely (see lib/rateLimit.ts and
# app/api/lead/route.ts) rather than every visitor sharing a single bucket.

# Bot user token for Telegram. Generated via @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat or group ID where the bot sends lead submissions. Negative number for groups.
TELEGRAM_CHAT_ID=

# Yandex.Metrika counter ID. Public by nature.
NEXT_PUBLIC_YM_ID=

# WhatsApp contact phone number in international format without + and separators.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Telegram contact handle (username without @).
NEXT_PUBLIC_CONTACT_TELEGRAM=

# Contact email address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Боевой домен сайта с протоколом, без слэша на конце (например https://lore.studio).
# Пока не задан, на Vercel берётся адрес продового деплоя, локально — localhost:3000.
NEXT_PUBLIC_SITE_URL=
