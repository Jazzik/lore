# Bot user token for Telegram. Generated via @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat or group ID where the bot sends lead submissions. Negative number for groups.
TELEGRAM_CHAT_ID=

# Yandex.Metrika counter ID. Public by nature.
NEXT_PUBLIC_YM_ID=

# WhatsApp contact phone number in international format without + and separators.
NEXT_PUBLIC_CONTACT_WHATSAPP=

# Telegram contact handle (username without @).
NEXT_PUBLIC_CONTACT_TELEGRAM=

# Contact email address.
NEXT_PUBLIC_CONTACT_EMAIL=
